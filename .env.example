# Copy to .env and fill in. NEVER put a real key in this file: it is meant to be shared.
OPENAI_API_KEY=your-key-here

# Optional: use another OpenAI-compatible server instead of OpenAI, for example Ollama
# EVALKIT_LLM_BASE_URL=http://localhost:11434/v1
# EVALKIT_GEN_MODEL=llama3.1
# EVALKIT_JUDGE_MODEL=llama3.1

# Retrieval knobs (defaults shown)
# EVALKIT_CHUNK_STRATEGY=fixed
# EVALKIT_CHUNK_SIZE=800
# EVALKIT_CHUNK_OVERLAP=100
# EVALKIT_TOP_K=5
